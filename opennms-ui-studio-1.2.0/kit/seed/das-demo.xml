<?xml version="1.0" encoding="UTF-8"?>
<!-- Development demo: six DAS nodes without IP interfaces, so nothing is polled. Each node names its parent,
     the node it hangs off in the DAS: the Path Outage view draws them as a tree, and OpenNMS uses parents
     to suppress notifications for nodes behind a node that is down. -->
<model-import xmlns="http://xmlns.opennms.org/xsd/config/model-import" foreign-source="DAS-Demo">
  <node foreign-id="orion-1" node-label="orion-1"><category name="Orion"/></node>
  <node foreign-id="helix-1" node-label="helix-1" parent-foreign-source="DAS-Demo" parent-foreign-id="orion-1"><category name="Helix"/></node>
  <node foreign-id="stratus-1" node-label="stratus-1" parent-foreign-source="DAS-Demo" parent-foreign-id="orion-1"><category name="Stratus"/></node>
  <node foreign-id="stratus-2" node-label="stratus-2" parent-foreign-source="DAS-Demo" parent-foreign-id="orion-1"><category name="Stratus"/></node>
  <node foreign-id="nimbus-1" node-label="nimbus-1" parent-foreign-source="DAS-Demo" parent-foreign-id="helix-1"><category name="Nimbus"/></node>
  <node foreign-id="nimbus-2" node-label="nimbus-2" parent-foreign-source="DAS-Demo" parent-foreign-id="helix-1"><category name="Nimbus"/></node>
</model-import>
