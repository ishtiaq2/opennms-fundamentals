# Settings for dev.sh and deploy.sh. Each one can also be set in the environment.

# Development stack: the images and versions of the official OpenNMS 33.1.8 compose example.
# Set PG_IMAGE to the PostgreSQL major version you run in production (Horizon 33 supports 10-16).
ONMS_IMAGE=${ONMS_IMAGE:-docker.io/opennms/horizon:33.1.8}
PG_IMAGE=${PG_IMAGE:-docker.io/library/postgres:15}
DEV_POD=${DEV_POD:-onms-dev}
DEV_CONTAINER=${DEV_CONTAINER:-onms-dev-core}
DEV_PORT=${DEV_PORT:-8980}            # use another port if production runs on this machine
DEV_KARAF_PORT=${DEV_KARAF_PORT:-8101}
DEV_USER=${DEV_USER:-admin}
DEV_PASSWORD=${DEV_PASSWORD:-admin}

# Production: the running OpenNMS container, and the podman connection when it runs on
# another machine (podman system connection add prod ssh://user@host/run/user/1000/podman/podman.sock).
PROD_CONTAINER=${PROD_CONTAINER:-horizon}
PROD_CONNECTION=${PROD_CONNECTION:-}

# How podman is called, e.g. "sudo podman" for rootful containers.
PODMAN=${PODMAN:-podman}
