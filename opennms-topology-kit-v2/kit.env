# Settings for dev.sh and deploy.sh. Each one can also be set for a single run:
#   DEV_PORT=8981 ./dev.sh up

# Development stack: the images of the official OpenNMS 33.1.8 compose example. Set PG_IMAGE to the
# PostgreSQL major version of production.
ONMS_IMAGE=${ONMS_IMAGE:-docker.io/opennms/horizon:33.1.8}
PG_IMAGE=${PG_IMAGE:-docker.io/library/postgres:15}
DEV_POD=${DEV_POD:-onms-dev}
DEV_CONTAINER=${DEV_CONTAINER:-onms-dev-core}
DEV_PORT=${DEV_PORT:-8980}              # OpenNMS web UI
DEV_KARAF_PORT=${DEV_KARAF_PORT:-8101}  # Karaf shell: ssh -p 8101 admin@localhost
PREVIEW_PORT=${PREVIEW_PORT:-8099}      # live preview of npm run dev
DEV_USER=${DEV_USER:-admin}
DEV_PASSWORD=${DEV_PASSWORD:-admin}
DEV_HEAP=${DEV_HEAP:-}                  # OpenNMS Java heap such as 1024m; empty: sized to this machine
DEV_HOST=${DEV_HOST:-}                  # address shown in the URLs; empty: this machine's network address
OPEN_FIREWALL=${OPEN_FIREWALL:-yes}     # open DEV_PORT and PREVIEW_PORT in firewalld (asks sudo once)

# Production: the running OpenNMS container, and the podman connection when it runs on another machine
# (podman system connection add prod ssh://user@host/run/user/1000/podman/podman.sock).
PROD_CONTAINER=${PROD_CONTAINER:-horizon}
PROD_CONNECTION=${PROD_CONNECTION:-}

# How podman is called, e.g. "sudo podman" for rootful containers.
PODMAN=${PODMAN:-podman}
