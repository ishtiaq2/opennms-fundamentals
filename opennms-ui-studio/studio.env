# Settings of OpenNMS UI Studio. The OpenNMS settings (production ssh login, container names, ports, the login of the
# development OpenNMS) are in kit/kit.env, which kit/dev.sh and kit/topo.sh read too.

# The port of the studio's page, and the address it listens on (0.0.0.0: every network of this machine).
STUDIO_PORT=8990
STUDIO_HOST=0.0.0.0

# The page asks for an access token (it is in .studio/token; npm start prints the address with it).
# STUDIO_TOKEN=off   # no token: only on a machine nobody else reaches
