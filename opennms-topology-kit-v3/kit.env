# Settings for dev.sh and topo.sh. Each one can also be set for a single run: DEV_PORT=8981 ./dev.sh up

# Production: OpenNMS runs in container PROD_CONTAINER, as user PROD_SSH on that machine (rootless Podman).
PROD_SSH=${PROD_SSH:-maven-admin@192.168.0.36}
PROD_CONTAINER=${PROD_CONTAINER:-opennms}
PROD_URL=${PROD_URL:-http://192.168.0.36:8980/opennms}   # only for ./topo.sh icons prod

# Development OpenNMS on this machine: the production image, so it has the same files.
ONMS_IMAGE=${ONMS_IMAGE:-docker.io/opennms/maven:33.1.8-1192-g05c63c46e8}
ONMS_IMAGE_ARCHIVE=${ONMS_IMAGE_ARCHIVE:-}  # a "podman save" .tar of it; empty: copy it from production
PG_IMAGE=${PG_IMAGE:-docker.io/library/postgres:14}
DEV_POD=${DEV_POD:-onms-dev}
DEV_CONTAINER=${DEV_CONTAINER:-onms-dev-core}
DEV_PORT=${DEV_PORT:-8980}              # OpenNMS web UI
DEV_KARAF_PORT=${DEV_KARAF_PORT:-8101}  # Karaf shell: ssh -p 8101 admin@localhost
DEV_USER=${DEV_USER:-admin}
DEV_PASSWORD=${DEV_PASSWORD:-admin}
DEV_HEAP=${DEV_HEAP:-}                  # OpenNMS Java heap such as 1024m; empty: sized to this machine
DEV_HOST=${DEV_HOST:-}                  # address shown in the URLs; empty: this machine's network address
DEV_ENV=${DEV_ENV:-}                    # extra variables for the image, e.g. "TZ=Europe/Stockholm A=b"
OPEN_FIREWALL=${OPEN_FIREWALL:-yes}     # open DEV_PORT in firewalld for browsers on other computers

# How podman is called on this machine, e.g. "sudo podman" for rootful containers.
PODMAN=${PODMAN:-podman}
